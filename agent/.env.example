# bifrost agent env — committed expectations (live values live in the release's env/live-agent.env)
# v0.7: the LIVE brain is the yggdrasil root on :4100 (lk-yggdrasil) — the same one the
# PWA proxy talks to. Pointing OPENCODE_URL anywhere else = split brain, voice turns
# vanish from the chat (10-06 outage). agent.py compares at every boot and screams on drift.
# (v0.6.x releases keep their own copy: opencode on :4096.)
OPENCODE_URL=http://127.0.0.1:4100
# Mac Studio speech models (STT+TTS). Down = no voice on any session.
SPEACHES_URL=http://192.168.50.1:8001/v1
# the one STT model the Mac serves (10-19: faster-whisper-small 500s on the Mac = no transcripts)
STT_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
# yggdrasil's own model id (an opencode id → 400 on a fresh session, 10-19)
VOICE_MODEL=yggdrasil/glm-5.3-flash
# Live agent registration name — MUST differ from lab/sandbox agents on the
# shared LiveKit (10-06: a lab worker named 'bifrost' took live dispatches).
# Live = bifrost-live, the next slot = bifrost-ygg.
AGENT_NAME=bifrost-live
