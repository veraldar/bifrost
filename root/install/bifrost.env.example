# bifrost — the stack around the brain: app, bridge, voice, livekit, voice agent.
# install.sh creates ~/.config/bifrost/bifrost.env from this ONCE (mode 600) and
# never overwrites what you set. After editing, re-run install.sh: it regenerates
# the per-service env files and units from these values and restarts what changed.
# Plain KEY=value lines. No quotes, no $VARS, no ~.
# A variable set in install.sh's environment (e.g. BIFROST_APP_PORT=8092 ./install.sh)
# is written here and wins from then on.
# The brain (yggdrasil) keeps its own file: ~/.config/yggdrasil/yggdrasil.env.

# --- network -------------------------------------------------------------------
# The address phones dial. Empty = detected on every install run (the source
# address of the default route). Re-run install.sh if your box's LAN IP changes.
BIFROST_LAN_IP=
# Phone UI + the /api seam (node server.mjs). 0.0.0.0 = the LAN for phones AND
# 127.0.0.1 for the box console (only the console may show the pairing QR).
BIFROST_APP_HOST=0.0.0.0
BIFROST_APP_PORT=8082
# Bridge: pairing identity + P2P signaling (tcp) and P2P media (udp, on the LAN IP).
BIFROST_BRIDGE_PORT=7890
BIFROST_MEDIA_PORT=7891

# --- pairing -------------------------------------------------------------------
# devices: every phone pairs by scanning the QR at http://127.0.0.1:<app port>/pair
#          opened ON THE BOX. Unpaired devices get 401 on every /api call.
# tailnet: no device tokens at all. Use ONLY when the app is reachable solely over
#          tailscale (tailscale serve gives you https + the tailnet as the gate).
BIFROST_AUTH=devices
# Bearer token for pairing from another machine (curl … /api/pair/code). Generated.
BIFROST_ADMIN_TOKEN=

# --- voice: speech server (STT + TTS, OpenAI-compatible) -------------------------
# local (default, SPEACHES_URL empty): bifrost-voice.service on 127.0.0.1:BIFROST_VOICE_PORT
# (sherpa-onnx, CPU). Its STT/TTS models (~200 MB) download on its FIRST start.
SPEACHES_URL=
BIFROST_VOICE_PORT=8000
# A Mac MLX speech server on your LAN instead (install.sh then skips the local one):
#SPEACHES_URL=http://<mac-ip>:8001/v1
#STT_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
#TTS_MODEL=cr2k2/Qwen3-TTS-12Hz-1.7B-Base-fp32

# --- livekit: the realtime voice transport ---------------------------------------
# binary (default): install.sh downloads livekit-server, generates the API key and
#                   secret below, advertises the LAN IP, runs bifrost-livekit.service.
#                   Needs no account.
# cloud:            your LiveKit Cloud project. Set LIVEKIT_URL (wss://…livekit.cloud),
#                   LIVEKIT_API_KEY and LIVEKIT_API_SECRET; no local server runs.
LIVEKIT_MODE=binary
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# binary mode only: signaling (tcp), ICE/TCP fallback (tcp) and media (udp).
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# --- voice agent (LiveKit worker: speech in → brain → speech out) ----------------
# Its health server port. Optional: the model the agent asks the brain for.
AGENT_HTTP_PORT=8081
#VOICE_MODEL=
