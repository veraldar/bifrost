[Unit]
Description=lane-watcher — wake MAIN when a lane lands in /tmp/sub-status.tsv
After=default.target

[Service]
ExecStart=%h/Work/bifrost/scripts/watch-landings.sh
# owner law 11-09 (watch survival): the station must never go silent — not on crash,
# not on reboot. Restart=always + enabled at default.target.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
