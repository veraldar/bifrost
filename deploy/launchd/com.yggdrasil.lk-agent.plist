<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- The LiveKit voice worker (lk-agent). RunAtLoad + KeepAlive make voice
       boot-self-healing like com.yggdrasil.bifrost-pwa / com.yggdrasil.livekit:
       on this box the 2026-11-10 14:21 reboot killed the hand-started worker
       and nobody noticed until every room went agent-less the next morning
       (diag 2026-11-11 06:06, session audii). Install:
         cp deploy/launchd/com.yggdrasil.lk-agent.plist ~/Library/LaunchAgents/
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.yggdrasil.lk-agent.plist
       Register proof: grep 'registered worker' in the log below. -->
  <key>Label</key><string>com.yggdrasil.lk-agent</string>
  <key>ProgramArguments</key><array>
    <string>/Users/yggdrasil/.local/bin/uv</string>
    <string>run</string>
    <string>agent.py</string>
    <string>dev</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/yggdrasil/yggdrasil-bifrost/agent</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/yggdrasil/yggdrasil-bifrost/agent/agent.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/yggdrasil/yggdrasil-bifrost/agent/agent.launchd.log</string>
</dict></plist>
