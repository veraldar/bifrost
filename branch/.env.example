# LiveKit (get a key/secret from your deployment, e.g. trunk/deploy/.env on the server)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-secret

# opencode REST server (must be reachable from this deployment)
# SECURITY: opencode has shell access to the host running it — never expose
# it publicly without an auth layer. Keep it on a private network (e.g. Tailscale).
OPENCODE_URL=http://127.0.0.1:4096

# Web Push (generate: npx web-push generate-vapid-keys --json)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Declares the auth layer (middleware.ts):
#   tailnet = tailscale membership is the authentication. No device tokens; every route
#             behaves as before. Serve with `next start` (npm start) behind `tailscale serve`.
#             Required for LiveKit voice: /api/token and /api/dispatch refuse in any other mode.
#   devices = v0.9 pairing (docs/spec-pairing.md): every /api call needs a device access token
#             from the QR claim (/pair) — except the box's own console (a loopback peer) and
#             BIFROST_ADMIN_TOKEN. MUST be served by `node server.mjs`: only it stamps the real
#             peer address (x-bifrost-peer) that region binding and the console rule read —
#             under plain `next start` every request reads as region "unknown".
BIFROST_AUTH=tailnet

# --- devices mode (pairing) -----------------------------------------------------------
# The registry the app writes and the bridge verifies (sha256 hashes only, chmod 600).
#BIFROST_DEVICES_FILE=.devices.json
# Bearer token for pairing from another machine (curl -H 'Authorization: Bearer …' …/api/pair/code).
#BIFROST_ADMIN_TOKEN=
# The address phones dial — the QR encodes <BIFROST_PUBLIC_URL>/pair#… (default: the request origin).
#BIFROST_PUBLIC_URL=http://192.168.1.10:8082
# The local bridge (bifrost-net bridge): GET /identity gives the DTLS fingerprint the QR pins.
#BIFROST_BRIDGE_URL=http://127.0.0.1:7890
# The brain session a freshly paired phone lands on (created on first pair).
#BIFROST_MAIN_TITLE=main
# server.mjs: listen address, and BIFROST_TRUST_PROXY=1 only behind a reverse proxy YOU run.
#PORT=8095
#HOST=0.0.0.0
#BIFROST_TRUST_PROXY=
# Tuning (seconds / counts): BIFROST_ACCESS_TTL_S (900) BIFROST_REFRESH_TTL_S (2592000)
# BIFROST_PAIR_TTL_S (300) BIFROST_ROTATE_GRACE_S (30) BIFROST_RATE_BURST (300)
# BIFROST_RATE_PER_SEC (5) BIFROST_PAIR_BURST (60); BIFROST_REGION_POLICY=repair makes a
# network change need a fresh QR scan instead of a refresh.

# --- relay (optional): YOUR access point, never a third party ---------------------------
# Empty (the default) = no STUN/TURN at all: the bridge join uses LAN host candidates only.
# Set these only for a server you rent, in the country you choose (lib/ice.ts).
#BIFROST_TURN_URLS=turn:ap.example.net:3478?transport=udp,turn:ap.example.net:443?transport=tcp
#BIFROST_TURN_SECRET=
#BIFROST_TURN_TTL_S=21600
