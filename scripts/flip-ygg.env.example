# flip-ygg.sh upstream config — where yggdrasil (port 4100) gets its brain.
# Copy to scripts/flip-ygg.env (gitignored) and fill in an OpenAI-compatible
# endpoint. WITHOUT this file the flip runs the lab mock upstream: the whole
# flip path (proxy swap, restarts, re-arm, pushes) is exercised, replies come
# from lab/yggdrasil/mock/mock_upstream.py.
#
# YGG_UPSTREAM_BASE_URL=https://api.openai.com/v1
# YGG_UPSTREAM_API_KEY=sk-...
# YGG_UPSTREAM_MODEL=gpt-4o-mini
