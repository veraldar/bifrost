cted.subset_isClopen\r\nisTotallyDisconnected_of_clopen_set -> isTotallyDisconnected_of_isClopen_set\r\nLocallyConstant.ofClopen_fiber_one -> LocallyConstant.ofIsClopen_fiber_one\r\nLocallyConstant.ofClopen_fiber_zero -> LocallyConstant.ofIsClopen_fiber_zero\r\nLocallyConstant.ofClopen -> LocallyConstant.ofIsClopen\r\npreimage_clopen_of_clopen -> preimage_isClopen_of_isClopen\r\nTopologicalSpace.Clopens.clopen -> TopologicalSpace.Clopens.isClopen","tree":{"url":"https://api.github.com/repos/leanprover-community/mathlib4/git/trees/4207f67e2b4e2315da4191edb5f5e5dd7b5e05e0","sha":"4207f67e2b4e2315da4191edb5f5e5dd7b5e05e0"},"comment_count":0},"author":{"login":"grunweg","id":10105016,"node_id":"MDQ6VXNlcjEwMTA1MDE2","avatar_url":"https://avatars.githubusercontent.com/u/10105016?v=4","gravatar_id":"","url":"https://api.github.com/users/grunweg","html_url":"https://github.com/grunweg","followers_url":"https://api.github.com/users/grunweg/followers","following_url":"https://api.github.com/users/grunweg/following{/other_user}","gists_url":"https://api.github.com/users/grunweg/gists{/gist_id}","starred_url":"https://api.github.com/users/grunweg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/grunweg/subscriptions","organizations_url":"https://api.github.com/users/grunweg/orgs","repos_url":"https://api.github.com/users/grunweg/repos","events_url":"https://api.github.com/users/grunweg/events{/privacy}","received_events_url":"https://api.github.com/users/grunweg/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"grunweg","id":10105016,"node_id":"MDQ6VXNlcjEwMTA1MDE2","avatar_url":"https://avatars.githubusercontent.com/u/10105016?v=4","gravatar_id":"","url":"https://api.github.com/users/grunweg","html_url":"https://github.com/grunweg","followers_url":"https://api.github.com/users/grunweg/followers","following_url":"https://api.github.com/users/grunweg/following{/other_user}","gists_url":"https://api.github