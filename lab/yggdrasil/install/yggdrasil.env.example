# yggdrasil configuration. systemd reads this file through EnvironmentFile=.
# Use plain KEY=value lines. Quotes are not needed, and $VARS and ~ are NOT expanded.
# After editing, run: systemctl --user restart yggdrasil

# REQUIRED. Base URL of an OpenAI-compatible API; `/chat/completions` is appended.
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://127.0.0.1:11434/v1
#   llama.cpp / vLLM / LM Studio: http://127.0.0.1:<port>/v1
YGG_UPSTREAM_BASE_URL=

# Bearer token for the upstream. Leave empty for local servers that don't need one.
YGG_UPSTREAM_API_KEY=

# Model name sent upstream. bifrost's model picker shows this name.
YGG_UPSTREAM_MODEL=gpt-4o-mini

# Bind address. 4100 avoids colliding with opencode's 4096, so both can run side by side.
# Point bifrost at it with OPENCODE_URL=http://127.0.0.1:4100.
# Keep it on 127.0.0.1 (or a tailnet IP): there is no authentication.
YGG_LISTEN=127.0.0.1:4100

# Where sessions are stored, one session/<id>.json per session. install.sh writes an absolute path here.
YGG_DATA_DIR=@DATA@

# Optional. A JSON file {"providers":[...],"agents":[...]} served as /config/providers and /agent.
# Leave it unset to get one provider/model (YGG_UPSTREAM_MODEL) and the agents build + plan.
#YGG_CATALOG=/path/to/catalog.json
