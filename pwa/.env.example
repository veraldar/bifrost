# LiveKit (get a key/secret from your deployment, e.g. deploy/.env on the server)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-secret

# opencode REST server (must be reachable from this deployment)
# SECURITY: opencode has shell access to the host running it — never expose
# it publicly without an auth layer. Keep it on a private network (e.g. Tailscale).
OPENCODE_URL=http://127.0.0.1:4096

# Web Push (generate: npx web-push generate-vapid-keys --json)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Declares the auth layer: 'tailnet' = tailscale membership is the authentication.
# Required in production deployments (the token route refuses without it).
BIFROST_AUTH=tailnet
